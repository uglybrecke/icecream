<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin</title>

    <!-- 2 libraries, jquery has to come first -->
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src="https://cdn.datatables.net/3.1.4/js/dataTables.min.js"></script>

    <!-- jquery data-tables css -->
    <link rel="stylesheet" href="https://cdn.datatables.net/3.1.4/css/dataTables.dataTables.min.css">
</head>
<body>
    <h1>Orders</h1>
    <table id="order-table" class="display">
        <thead>
            <tr>
                <th>NAME</th>
                <th>EMAIL</th>
                <th>FLAVOR</th>
                <th>CONE</th>
                <th>TOPPINGS</th>
                <th>COMMENTS</th>
                <th>DATE/TIME</th>
            </tr>
        </thead>
        <tbody>
            <% orders.forEach(order => { %>
                <tr>
                    <td><%= order.name %></td>
                    <td><%= order.email %></td>
                    <td><%= order.flavor %></td>
                    <td><%= order.cone %></td>
                    <td><%= order.topping %></td>
                    <td><%= order.comment %></td>
                    <td><%= order.timestamp.toLocaleString() %></td>
                </tr>
            <% }); %>
        </tbody>
    </table>

    <script>
        new DataTable('#order-table');
    </script>

</body>
</html>